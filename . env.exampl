
# ==========================================
# 1. SERVER & SYSTEM CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ==========================================
# 2. POSTGRESQL DATABASE CREDENTIALS
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=smgpub_platform_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database Connection String for Node.js / pg Pool
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@postgres:5432/smgpub_platform_db

# ==========================================
# 3. DOMAIN & FRONTEND PUBLIC URLS
# ==========================================
# Backend API Base URL (Used by Next.js & Mobile Client)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Web Dashboard Frontend Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Consumer Beat Store Domain
NEXT_PUBLIC_BEATSTORE_URL=http://localhost

# ==========================================
# 4. STRIPE PAYMENT GATEWAY & WEBHOOKS
# ==========================================
# Stripe API Keys (Get from Dashboard > API Keys)
STRIPE_PUBLIC_KEY=pk_test_51...
STRIPE_SECRET_KEY=sk_test_51...

# Stripe Webhook Endpoint Secret (Get from Stripe CLI or Webhooks Panel)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Direct Purchase Links for Flagship Audio Stems
STRIPE_CHECKOUT_EMIN11_GROOVE_URL=https://checkout.stripe.com/pay/cs_live_emin11
STRIPE_CHECKOUT_DM9_VAMP_URL=https://checkout.stripe.com/pay/cs_live_dm9
STRIPE_CHECKOUT_FUNK_ROCK_URL=https://checkout.stripe.com/pay/cs_live_funkrock

# ==========================================
# 5. SECURITY & AUTHENTICATION
# ==========================================
# Secret key used for signing JWT user tokens
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# ==========================================
# 6. CORS & REVERSE PROXY
# ==========================================
# Allowed origins for API requests (comma-separated for multiple domains)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://smgpub.com,https://app.smgpub.com
